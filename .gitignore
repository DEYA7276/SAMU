# ==============================================================================
# SAMU UTGZ — Global .gitignore
# ==============================================================================

# OS & IDE
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Sensitive Credentials (CRITICAL: Do NOT commit secrets!)
.env
.env.backup
.env.production
.env.local
*.env
backend/.env
frontend/.env
*.pem
*.key

# Dependencies
node_modules/
backend/vendor/

# Backend (Laravel)
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitignore
!backend/storage/app/public/.gitignore
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/public/storage
backend/public/hot

# Frontend (Ionic + Angular)
frontend/.angular/
frontend/www/
frontend/dist/
frontend/.cache/
frontend/coverage/

# Capacitor
frontend/android/app/build/
frontend/android/.gradle/
frontend/ios/App/build/
frontend/ios/App/Pods/
frontend/ios/App/Podfile.lock
